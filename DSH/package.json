{
  "name": "@neptunekit/dsh-tritonkit-host",
  "version": "0.1.0",
  "description": "TritonKit CLI tools for local app discovery, observation, actions and verification in DSH.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "exports": {
    ".": "./host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["host.js", "commands.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.1" },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check host.js && node --check commands.js" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
