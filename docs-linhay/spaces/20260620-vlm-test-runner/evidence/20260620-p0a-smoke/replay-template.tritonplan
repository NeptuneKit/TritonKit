{
  "name" : "replay-template",
  "schemaVersion" : 1,
  "steps" : [
    {
      "action" : "tap",
      "text" : "登录"
    },
    {
      "action" : "tap",
      "x" : 180,
      "y" : 250
    },
    {
      "action" : "paste",
      "value" : "${username}"
    },
    {
      "action" : "tap",
      "x" : 180,
      "y" : 304
    },
    {
      "action" : "paste",
      "secure" : true,
      "value" : "${password}"
    },
    {
      "action" : "tap",
      "x" : 201,
      "y" : 459
    },
    {
      "action" : "wait",
      "gone" : "登录",
      "timeout" : 15
    },
    {
      "action" : "evidence",
      "name" : "login-success"
    }
  ],
  "target" : {
    "id" : "triton:local"
  },
  "variables" : [
    "username",
    "password"
  ]
}